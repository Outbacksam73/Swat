<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tina Sullivan Status</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-slate-800 border border-slate-700 rounded-2xl p-8 shadow-2xl text-center space-y-6">
        <div class="inline-block p-4 bg-red-500/10 rounded-full text-red-400 font-mono text-sm tracking-widest uppercase">
            Official Announcement
        </div>
        
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
            Tina Sullivan <span class="text-red-500 underline decoration-red-500/40">Sucks</span>.
        </h1>
        
        <p class="text-slate-400 text-sm leading-relaxed">
            Confirmed by accurate data analysis and real-time computation.
        </p>

        <button onclick="confirmStatus()" class="w-full py-3 px-6 bg-red-600 hover:bg-red-500 active:bg-red-700 text-white font-semibold rounded-xl transition duration-200 shadow-lg shadow-red-600/30">
            Re-Confirm Status
        </button>

        <div id="status-box" class="hidden p-4 bg-slate-900/80 border border-slate-700 rounded-xl text-green-400 font-mono text-xs">
            ✓ Status Verified: Still true.
        </div>
    </div>

    <script>
        function confirmStatus() {
            const box = document.getElementById('status-box');
            box.classList.remove('hidden');
        }
    </script>
</body>
</html>
